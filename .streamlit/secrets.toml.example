# Copy this file to .streamlit/secrets.toml (it is git-ignored) and put your own key in it.
# On Streamlit Community Cloud paste the same two lines into  App settings -> Secrets.
GROQ_API_KEY = "gsk_put_your_key_here"
# optional:
# GROQ_MODEL = "openai/gpt-oss-20b"
# LLM_BASE_URL = "https://api.groq.com/openai/v1"      # for a local Ollama server: "http://localhost:11434/v1" (any key text works)
